{
  "name": "nutrisync-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/src/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node server/src/index.js",
    "build": "vite build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "node --test server/test/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "framer-motion": "^13.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.48.0",
    "prisma": "^6.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reaviz": "^16.2.2",
    "tailwind-merge": "^3.7.0",
    "vite": "^6.0.5",
    "zod": "^3.24.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "concurrently": "^9.1.2"
  },
  "devDependencies": {}
}